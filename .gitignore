# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
functions/node_modules
functions/lib
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# functions/.env holds non-secret Cloud Functions params (firebase-functions/params)
# and is meant to be committed — only functions/.env.local (local override) stays ignored.
!functions/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.claude